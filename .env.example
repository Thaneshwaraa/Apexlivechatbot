# Copy to .env and fill in. Get the token from https://discord.com/developers/applications → Bot.
DISCORD_TOKEN=

# Optional: register slash commands to one server only (they appear instantly there).
# Leave empty to register globally (can take up to an hour the first time).
DEV_GUILD_ID=

# Optional: where links in messages point.
SITE_URL=https://thaneshwaraa.github.io/Apexlive

# Optional: where server settings and sent-reminder state are kept.
DATA_FILE=data/state.json

# Optional: timezone for times in messages (default Asia/Kolkata, shown as IST).
# Use any IANA zone, e.g. Europe/London, or "local" to show each reader's own timezone.
DISPLAY_TZ=Asia/Kolkata
